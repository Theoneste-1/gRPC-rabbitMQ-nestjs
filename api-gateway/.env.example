# API Gateway Configuration
GATEWAY_PORT=3000
NODE_ENV=development

# Auth Service gRPC URL
AUTH_GRPC_URL=localhost:5001

# Reporting Service gRPC URL
REPORTING_GRPC_URL=localhost:5003

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
